        {"kind":"line","x1":345,"y1":125,"x2":345,"y2":280,"color":"#BFBFBF","width":1.2},
        {"kind":"text","x":375,"y":130,"w":250,"h":34,"text":"Virtual WAN","size":20,"color":"#000FB3","bold":true,"align":"center"},
        {"kind":"text","x":375,"y":177,"w":250,"h":78,"text":"多拠点の接続を\\nマネージドハブで集約","size":16,"color":"#202020","align":"center"},
