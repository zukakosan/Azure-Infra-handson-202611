        {"kind":"text","x":75,"y":170,"w":360,"h":92,"text":"UDRを作成したが未関連付け\\n送信元ではなく宛先側に設定\\nより具体的な経路を見落とす","size":16,"color":"#202020"},
        {"kind":"line","x1":480,"y1":125,"x2":480,"y2":295,"color":"#BFBFBF","width":1.2},
        {"kind":"text","x":520,"y":125,"w":360,"h":32,"text":"転送・復路","size":20,"color":"#000FB3","bold":true},
        {"kind":"text","x":525,"y":170,"w":355,"h":92,"text":"Hubのピアリングを推移的と誤認\\nNVAのOS側転送が無効\\n往路だけFirewallへ誘導","size":16,"color":"#202020"},
        {"kind":"rect","x":95,"y":315,"w":770,"h":66,"fill":"#FFF4CE","line":"#F7630C"},
        {"kind":"text","x":115,"y":328,"w":730,"h":40,"text":"証拠：NICの有効ルート → Next hop → 装置ログ → 復路","size":17,"color":"#202020","bold":true,"align":"center"}
      ]
